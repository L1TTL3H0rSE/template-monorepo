# Каждая переменная выводится из структуры Config: блок с env-prefix + имя поля.
# Отдельной таблицы соответствий не существует — см. config/config.go.

# HTTP-сервер (kithttp.Config, префикс SERVER_)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# PostgreSQL (postgres.Config, префикс DB_)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gotemplate
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h

# Логирование (logger.Config, префикс LOG_)
LOG_LEVEL=info
LOG_FORMAT=json

# Общий кеш (cache.Config, префикс CACHE_)
CACHE_DEFAULT_TTL=5m
CACHE_CLEANUP_INTERVAL=1m

# Rate limit на /api/v1 после аутентификации (ratelimiter.Config, префикс RATELIMIT_)
RATELIMIT_ENABLED=true
RATELIMIT_RATE=100
RATELIMIT_PERIOD=1m
RATELIMIT_BURST=20
