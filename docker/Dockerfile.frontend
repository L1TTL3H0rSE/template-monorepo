# syntax=docker/dockerfile:1
#
# Сборка Nuxt-приложения. Контекст — корень репозитория: приложение зависит от
# локальных пакетов workspace, которые нужно собрать до него.

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
# Манифесты копируются отдельно от исходников: слой установки зависимостей
# инвалидируется только при их изменении, а не при каждой правке кода.
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
COPY frontend/packages/components/package.json ./packages/components/
COPY frontend/packages/shared/package.json ./packages/shared/
COPY frontend/packages/api/package.json ./packages/api/
COPY frontend/packages/eslint-config/package.json ./packages/eslint-config/
COPY frontend/applications/web/package.json ./applications/web/

RUN --mount=type=cache,target=/pnpm-store \
    pnpm config set store-dir /pnpm-store && \
    pnpm install --frozen-lockfile --ignore-scripts

FROM deps AS build
COPY frontend/tsconfig.base.json ./
COPY frontend/packages ./packages
COPY frontend/applications ./applications

# Пакеты экспортируют dist, поэтому их сборка обязана предшествовать сборке
# приложения. Порядок задан скриптом build:local и повторяет граф зависимостей.
RUN pnpm build:local && \
    pnpm --filter @starter/web build

FROM node:22-alpine AS run
RUN addgroup -S app && adduser -S -G app app
WORKDIR /app

# Nitro собирает самодостаточный .output: node_modules в финальный образ не
# копируются.
COPY --from=build /app/applications/web/.output ./.output

ENV NODE_ENV=production
ENV NITRO_PORT=3000
ENV NITRO_HOST=0.0.0.0

EXPOSE 3000
USER app
CMD ["node", ".output/server/index.mjs"]
