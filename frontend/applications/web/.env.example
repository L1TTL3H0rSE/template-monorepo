# Публичный runtime config запекается в клиентский бандл.
# Секретам здесь не место: всё, что попадает в public, видно пользователю.

# Провайдер данных: mock — встроенные фикстуры, http — реальный бэкенд.
# Выбор делается в app/api/api.ts — единственном месте, где встречается «mock».
NUXT_PUBLIC_API_PROVIDER=mock

# Базовый URL API при NUXT_PUBLIC_API_PROVIDER=http.
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
