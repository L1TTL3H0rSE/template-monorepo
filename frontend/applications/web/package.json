{
  "name": "@roleplay/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:coverage": "vitest run --coverage",
    "perf:bundle": "pnpm build && node scripts/report-client-assets.mjs applications/web/.output/public/_nuxt",
    "perf:bundle:json": "node scripts/report-client-assets.mjs applications/web/.output/public/_nuxt --json"
  },
  "dependencies": {
    "@pinia/nuxt": "catalog:",
    "@roleplay/api": "workspace:*",
    "@roleplay/components": "workspace:*",
    "@roleplay/shared": "workspace:*",
    "@vueuse/core": "catalog:",
    "@vueuse/nuxt": "catalog:",
    "pinia": "catalog:",
    "sass-embedded": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@roleplay/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "nuxt": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  }
