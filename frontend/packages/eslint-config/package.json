{
  "name": "@starter/eslint-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Общие flat-конфигурации ESLint для всех пакетов и приложений.",
  "exports": {
    ".": "./vue.js",
    "./vue": "./vue.js",
    "./nuxt": "./nuxt.js",
    "./storybook": "./storybook.js",
    "./prettier": "./shared/prettier.js",
    "./typed": "./typed.js",
    "./boundaries": "./boundaries.js"
  },
  "files": [
    "vue.js",
    "nuxt.js",
    "storybook.js",
    "shared",
    "typed.js",
    "conventions.js",
    "boundaries.js"
  ],
  "peerDependencies": {
    "eslint": ">=9"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "prettier": "catalog:",
    "typescript-eslint": "catalog:",
    "vue-eslint-parser": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-vuejs-accessibility": "catalog:"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
